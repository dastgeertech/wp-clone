DATABASE_URL=postgresql://wp:wp@localhost:5432/wpclone
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long-xxxx
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long-xxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
API_PORT=3333
# Base URL the SSR web server uses to call the API (server-side only)
API_URL=http://localhost:3333/api
# Where uploaded media is stored (default: ./storage/uploads)
UPLOAD_DIR=storage/uploads
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4300
# Hostnames the SSR server accepts (Host-header validation, anti host-poisoning).
# Baked defaults: localhost,127.0.0.1 — append your production domain(s), e.g.
# NG_ALLOWED_HOSTS=www.example.com,example.com

