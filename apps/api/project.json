{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npx nodemon --config apps/api/nodemon.json",
        "env": { "SWC_NODE_PROJECT": "apps/api/tsconfig.app.json" }
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register apps/api/src/main.ts",
        "env": { "SWC_NODE_PROJECT": "apps/api/tsconfig.app.json", "NODE_ENV": "production" }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/api/tsconfig.app.json --noEmit" }
    }
  }
}
