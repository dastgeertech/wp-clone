{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "../..",
    "types": [
      "node"
    ],
    "declaration": false,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "esModuleInterop": true,
    "paths": {
      "@wp-clone/shared-types": [
        "../../libs/shared-types/src/shared-types.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../libs/shared-types/src/**/*.ts"
  ],
  "exclude": [
    "prisma/**"
  ]
}