  "license": "MIT",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "setup:docker": "npm run db:up && npm run setup",
    "dev": "nx run-many -t serve -p api web admin",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web --port 4200",
    "dev:admin": "nx serve admin --port 4300",
    "typecheck": "nx typecheck api",
    "smoke": "node scripts/smoke.mjs",
    "e2e:admin": "node scripts/admin-e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build": "nx run-many -t build -p web admin",
    "start:api": "nx start api",
    "start:web": "node dist/apps/web/server/server.mjs"
  },
  "private": true,
